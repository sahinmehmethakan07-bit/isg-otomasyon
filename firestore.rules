// ─── firestore.rules ─────────────────────────────────────────────────────────
// sessions collection kurallarını mevcut kurallarınıza ekleyin.
// ─────────────────────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mevcut kurallarınız...
    match /companies/{docId} { allow read, write: if request.auth != null; }
    match /employees/{docId} { allow read, write: if request.auth != null; }
    match /documents/{docId} { allow read, write: if request.auth != null; }
    match /observers/{docId} { allow read, write: if request.auth != null; }
    match /dofs/{docId}      { allow read, write: if request.auth != null; }
    match /risks/{docId}     { allow read, write: if request.auth != null; }
    match /signers/{docId}   { allow read, write: if request.auth != null; }
    match /settings/{docId}  { allow read, write: if request.auth != null; }

    // ── SESSION KURALLARI ────────────────────────────────────────────────────
    match /sessions/{userId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow write:  if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
